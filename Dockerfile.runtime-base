# BuildKit's built-in frontend, deliberately: no `# syntax=` directive.
#
# Directiva aceea cerea `docker/dockerfile:1.4` de pe Docker Hub LA FIECARE BUILD, necacheabil — iar
# pe 2026-10-26 un `502 Bad Gateway` de acolo a omorât un build musl de peste o oră în prima
# secundă, înainte ca vreo linie din palmares să fie atinsă.
#
# Verificat înainte de a o scoate: niciunul din cele șase Dockerfile nu folosește ceva ce 1.4 aduce
# — zero `RUN --mount`, zero `COPY --link`, zero `--chmod`, zero heredoc. Singurele flaguri sunt
# `COPY --from`, standard de ani de zile, plus flaguri ale comenzilor rulate (git, cabal, apk).
# Deci directiva nu cumpăra nimic și costa o dependență de rețea pe calea critică.
# Shared runtime base for all services (statically-linked binaries).
# Only runtime essentials – no build toolchain.
FROM --platform=$TARGETPLATFORM alpine:3.20

RUN apk add --no-cache \
    bash \
    curl \
    ca-certificates \
    postgresql-client \
    postgresql-libs \
    ncurses-libs \
    libsodium \
    libsecp256k1 \
    libstdc++ \
    gmp \
    libgcc \
    xz-libs

# libsodium 1.0.19 (for libsodium.so.26)
RUN apk add --no-cache --virtual .build-deps \
      build-base curl autoconf automake libtool && \
    curl -LO https://download.libsodium.org/libsodium/releases/libsodium-1.0.19.tar.gz && \
    tar xvf libsodium-1.0.19.tar.gz && \
    cd libsodium-stable && \
    ./configure --prefix=/usr --enable-shared --disable-static && \
    make && make install && \
    cd / && rm -rf libsodium-stable libsodium-1.0.19.tar.gz

# secp256k1 (schnorr)
RUN apk add --no-cache --virtual .secp-deps \
      build-base git autoconf automake libtool && \
    git clone --depth 1 --branch 'v0.3.2' https://github.com/bitcoin-core/secp256k1 && \
    cd secp256k1 && \
    ./autogen.sh && \
    ./configure --enable-module-schnorrsig --enable-experimental && \
    make && make check && make install && \
    cd / && rm -rf secp256k1

# BLST
ARG BLST_REF=v0.3.15
COPY libblst.pc /usr/lib/pkgconfig/
RUN apk add --no-cache --virtual .blst-deps build-base git && \
    git clone https://github.com/supranational/blst && \
    cd blst && \
    git checkout ${BLST_REF} && \
    ./build.sh && \
    cp bindings/blst_aux.h bindings/blst.h bindings/blst.hpp /usr/include/ && \
    cp libblst.a /usr/lib/ && \
    chmod u=rw,go=r /usr/lib/pkgconfig/libblst.pc \
      /usr/include/blst_aux.h /usr/include/blst.h /usr/include/blst.hpp \
      /usr/lib/libblst.a && \
    cd / && rm -rf blst

# Clean up all build deps
RUN apk del .build-deps .secp-deps .blst-deps 2>/dev/null || true

# NO `USER` HERE, DELIBERATELY — TD-11 is closed in the four service images instead, each of which
# ends `USER nobody`. Two reasons it belongs there and not here. This image is only ever a `FROM`
# target: it has no entrypoint and nothing starts it as a container, while every `RUN` above does
# `make install` into `/usr` and needs root. And setting it here would silently demote the children's
# own `WORKDIR`, `COPY --from` and `mkdir` steps, which is a build-time behaviour change nobody can
# verify without running the four builds.
#
# The account the children use is `nobody` (uid/gid 65534) out of alpine's baselayout `/etc/passwd`,
# so no `adduser` is needed; if a dedicated uid is ever wanted for volume ownership, this is the file
# that grows the `adduser` line and the four `USER` lines that follow it.
