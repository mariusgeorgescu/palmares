{
  "name": "palmares-frontend",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@emurgo/cardano-serialization-lib-browser": "^11.5.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/http-proxy": "^11.1.1",
    "@fastify/static": "^8.0.1",
    "@tailwindcss/vite": "^4.1.10",
    "fastify": "^5.1.0",
    "http-server": "^14.1.1",
    "postcss-cli": "^11.0.1",
    "purescript": "^0.15.16",
    "purs-tidy": "^0.11.0",
    "spago": "^0.93.29",
    "vite": "^6.2.0",
    "vite-plugin-top-level-await": "^1.4.1",
    "vite-plugin-wasm": "^3.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.10",
    "autoprefixer": "^10.4.21",
    "daisyui": "^5.5.5",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.10",
    "vite-plugin-node-polyfills": "^0.26.0"
  },
  "scripts": {
    "format": "purs-tidy format-in-place 'src/**/*.purs' 'test/**/*.purs'",
    "check-formatting": "purs-tidy check 'src/**/*.purs' 'test/**/*.purs'",
    "test": "spago test",
    "build:spago": "spago bundle --bundle-type module --platform browser --module MainDemo --outfile public/index.js",
    "build:spago:prod": "spago bundle --bundle-type module --platform browser --module Main --outfile public/index.js",
    "build:css": "postcss src/style.css -o ./public/output.css",
    "build": "npm run build:spago && npm run build:css && npx vite build",
    "build:prod": "npm run build:spago:prod && npm run build:css && npx vite build",
    "dev": "npm run build:spago && npm run build:css && npx vite dev",
    "serve": "npm run build && npx vite serve",
    "start": "npm run build && node bff/server.js",
    "bff": "npm run build && node bff/server.js",
    "bff:dev": "node --watch bff/server.js",
    "deploy-dev": "docker buildx build --platform linux/amd64,linux/arm64 --provenance=false -t ghcr.io/mariusgeorgescu/palmares-frontend:dev -f Dockerfile . --push",
    "deploy-prod": "docker buildx build --platform linux/amd64,linux/arm64 --provenance=false -t ghcr.io/mariusgeorgescu/palmares-frontend:prod -f Dockerfile . --push"
  },
  "browser": {
    "child_process": false
  }
}
