# syntax=docker/dockerfile:1.4

# The two shared base images, as build args so the same Dockerfile works in both places it is
# used: locally (and from compose) the defaults are the plain tags a contributor builds with
# `docker build -f Dockerfile.base -t palmares-builder:9.6.6 .`, while CI overrides them with the
# GHCR refs it just pushed. Without the args, buildx resolves the bare names against Docker Hub —
# which is how the images workflow failed with `pull access denied` on docker.io/library.
ARG BUILDER_IMAGE=palmares-builder:9.6.6
ARG RUNTIME_IMAGE=palmares-runtime-base:3.20

### STAGE 1: Build ###
FROM --platform=$TARGETPLATFORM ${BUILDER_IMAGE} AS builder

WORKDIR /palmares

ENV PATH="/root/.cabal/bin:$PATH"
ENV CC=musl-gcc
ENV LD=musl-gcc

# Source copy (only layer that changes on code edits).
COPY src ./src
COPY config ./config

# `cabal install` of a local package builds an sdist first, and an sdist must contain every path
# palmares.cabal lists in extra-source-files. Without these the build dies with
#   cabal: sdist of palmares-0.1.0: filepath wildcard 'NOTICE' does not match any files
# which is how all four service images failed on the first images run that was not cancelled.
# Keep this list in step with extra-source-files.
COPY LICENSE NOTICE ./
COPY licenses ./licenses
COPY sql ./sql
COPY test/fixtures ./test/fixtures
# `resources/` is in extra-source-files (metric-formulas.json + metrics/*.sql) and was added
# without this line, so `cabal install` failed its sdist step with "filepath wildcard
# 'resources/metric-formulas.json' does not match any files" — the exact failure the cabal
# file's own comment warns about. Every extra-source-files path must be COPYed here.
COPY resources ./resources

RUN cabal install admin \
    --enable-executable-static \
    --overwrite-policy=always \
    --installdir=. \
    --install-method=copy \
    --ghc-options="-optl=-static -optl=-pthread -optc=-static"

### STAGE 2: Runtime ###
FROM --platform=$TARGETPLATFORM ${RUNTIME_IMAGE} AS runtime

WORKDIR /app
COPY --from=builder /palmares/admin /app/admin
# TD-01: NOT `COPY ./config /app/config`, which baked the live provider config into the image.
# Compose bind-mounts ./config over this path anyway, and in a cluster both files arrive by env, so
# the baked copy was never read — it was only shipped. The two reconcile files stay because
# `reconcile-koios` reads them from the image and neither is a secret.
COPY ./config/reconcile-exceptions.yaml ./config/reconcile-sample.preprod.json /app/config/

# TD-11. The earlier "stops running as superuser" commit was about the POSTGRES ROLE; the container
# itself still ran as uid 0. `nobody` (uid/gid 65534) is alpine's own baselayout account, so the
# runtime base needs no `adduser` of its own.
#
# The one command this image runs as a SERVICE is `apply-roles` (compose's `palmares-roles`), which
# touches Postgres over TCP and no file at all. `/app/admin` and the two reconcile files are landed
# by COPY as root:root 0644/0755, so `nobody` reads them.
#
# THE CALLER OWNS THE UID FOR ANYTHING THAT WRITES. `reconcile-koios --out` creates its report in
# the caller's directory (`Reconcile.hs:451-452`), and `deploy-reference-scripts` writes
# `config/config_palmares_validators.json` — both land in a bind mount owned by the host user, which
# is nobody's by definition. Those invocations pass `--user "$(id -u):$(id -g)"`;
# `.github/workflows/reconcile.yml` is the worked example.
#
# LAST instruction before the entrypoint on purpose: every RUN and COPY above needs root.
USER nobody

ENTRYPOINT ["/app/admin"]
