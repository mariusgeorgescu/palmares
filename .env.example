# Copy to `.env` (gitignored) and fill in. direnv sources it; nothing here may ever be committed
# with a real value.

# ---- required by interaction-api (fail-closed: it `die`s if unset). The admin CLI reads neither;
#      the smoke scripts need them to CALL the interaction API over HTTP. ----
BASIC_USER=
BASIC_PASS=
# Optional, and read by query-api, interaction-api and attest-sync. Unset or empty denies all
# cross-origin, which is the safe default and NOT a boot failure — each service PRINTS the resolved
# policy at boot (`CORS: …`), so grep the startup log rather than guessing. No trailing slash and no
# `*`: an Origin header is scheme://host[:port], so either one allows nothing at all.
CORS_ALLOWED_ORIGINS=        # comma-separated, e.g. https://gov.example.org,http://localhost:5173

# ---- required by compose.yaml, which has NO DEFAULT for any password (`TD-09`): `${VAR:?}` everywhere,
#      so `docker compose up` refuses and names the one you forgot. POSTGRES_PASSWORD is what initdb
#      bakes into the volume on first boot; the other two are what `apply-roles` CREATES palmares_owner
#      and palmares_ro with, and what query-api and attest-sync then connect as. Read by compose, never
#      by the Haskell — which is why the binaries' own fail-closed checks on the role passwords had
#      never once fired: compose was handing them `devonly`. ----
POSTGRES_PASSWORD=
PALMARES_OWNER_PASSWORD=
PALMARES_RO_PASSWORD=

# ---- Postgres: the request pool, db-sync's own database ----
# The password is BLANK on purpose. It read `password=postgres` here, which is a credential in a
# committed file even as a placeholder — and a placeholder that happens to be a real default
# somewhere is how `devonly` ended up authorising production-shaped boots.
PG_CONN_STR=host=postgres user=postgres password= dbname=cexplorer port=5432

# query-api applies the `palmares` schema and refreshes its one matview through a SECOND pool,
# because both need owner rights while every request should be served read-only. Unset, it falls
# back to PG_CONN_STR, so a single-role deployment works without it.
# PALMARES_PG_OWNER_CONN_STR=host=postgres user=palmares_owner password=... dbname=cexplorer port=5432

# ---- attest-sync (Kupo path only) ----
# Required, fail-closed: the projector's only view of the chain, so no default.
KUPO_URL=http://localhost:1442
# Slots per fetch window. The binary's own default is 10000000 — the whole chain in one window —
# so this line is what keeps a cabal-run projector to a sane first pass.
FETCH_BATCH_SIZE=100000
ROLLBACK_MARGIN=2160
# The slot gap beyond which attest-sync reports `is_way_behind`, and — in seconds — how long the
# projector may go without an answer from Kupo before /ready turns red. 1200 is the binary's default
# and twenty minutes at one second per slot; a projector with no word from Kupo for N seconds is at
# least N slots stale, which is why one number does both jobs. The GAP alone no longer reddens
# /ready: catching up is the job, and failing the probe for the whole of a first sync or a post-wipe
# re-sync is what stopped a rollout from ever completing. Unparseable or non-positive falls back to
# 1200 rather than failing the boot: it decides a probe's colour, not what the projector reads. The
# ceiling on how stale a projection a READER may be served is query-api's
# PALMARES_READY_MAX_LAG_SECONDS, which is the probe in front of the data.
READY_MAX_LAG_SLOTS=1200
# `CS-06`: a schema-version bump makes attest-sync DROP every chain-sync table and re-index from the
# chain. It now refuses to do that unless this names the STORED version being destroyed — the
# refusal prints the number. Commented out on purpose: a value left here would authorise the next
# wipe silently, which is the defect the guard exists to prevent. It also expires by itself, since
# after the wipe the stored version is the current one and the same value stops matching.
# ATTEST_SYNC_CONFIRM_WIPE=

# ---- Atlas + deployed validators: the JSON ITSELF, never a path. A path is a fatal boot error.
#      Leave both unset to read config/config_atlas.json and config/config_palmares_validators.json.
ATLAS_CORE_CONFIG=
DEPLOYED_VALIDATORS_CONFIG=
# MAESTRO_API_KEY is read by Atlas from the core config, never from here. Never commit a real one.

# ---- query-api ----
PORT=8083
PALMARES_VIEW_REFRESH_SECONDS=300   # Query/Refresh.hs: interval of the one matview's
                                    # REFRESH ... CONCURRENTLY (D-1)
PALMARES_READY_MAX_LAG_SECONDS=300  # /ready red above this (D-7)
PALMARES_AMBER_LAG_SECONDS=120      # UI amber above this (D-7)

# ---- test suite ----
# Named here because forgetting the first one is the single most common way this checkout looks
# broken: without it the database-backed cases fail in seconds and read as a bad build rather than
# as a missing service. `127.0.0.1` and not `localhost` — a port published by Docker is on 127.0.0.1
# only, and `localhost` resolves to ::1 first.
PALMARES_TEST_PG_CONN_STR="host=127.0.0.1 user=postgres password=devonly dbname=postgres port=55439"
# Optional: a SYNCED preprod db-sync, for the epoch-320 metric fixture. Left empty on purpose — the
# gate then reports SKIPPED inside passing cases.
PALMARES_FIXTURE_PG_CONN_STR=
# Any non-empty value turns that skip into a FAILURE. Left empty on purpose too: set it on the run
# that signs a release, where the fixture database is present, so "the gate passed" cannot quietly
# mean "the gate did not run". Setting it here without the line above makes every local run red.
PALMARES_REQUIRE_FIXTURE_GATE=
